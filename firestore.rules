rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', true) != false;
    }
    match /residents/{uid} {
      allow read: if own(uid) || admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasAll(['fullName', 'emailAddress', 'homeBarangay', 'dateRegistered', 'role'])
        && request.resource.data.keys().hasOnly(['fullName', 'emailAddress', 'homeBarangay', 'dateRegistered', 'role'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.homeBarangay is string
        && request.resource.data.homeBarangay.size() > 0
        && request.resource.data.homeBarangay.size() <= 100
        && request.resource.data.emailAddress == request.auth.token.email
        && request.resource.data.role == 'Resident'
        && request.resource.data.dateRegistered == request.time;
    }
    match /admins/{uid} {
      allow get: if own(uid);
      // Profiles are provisioned by the protected employee-management server or console.
      // Client writes remain denied, including changes to active and canManageEmployees.
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.keys().hasAll(['authorID', 'title', 'content', 'datePosted'])
        && request.resource.data.keys().hasOnly(['authorID', 'title', 'content', 'datePosted', 'announcementImageURL'])
        && request.resource.data.authorID == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 10000
        && request.resource.data.datePosted == request.time
        && (!('announcementImageURL' in request.resource.data)
          || (request.resource.data.announcementImageURL is string
            && request.resource.data.announcementImageURL.size() <= 2048
            && request.resource.data.announcementImageURL ==
              'https://lpcmwrdizcistkxylsps.supabase.co/storage/v1/object/public/announcement-images/' + announcementId + '/image'));
      allow delete: if admin();
    }
    // Private resident reports with optional confirmed map pins and admin processing.
    match /reports/{reportId} {
      function validText(value, limit) {
        return value is string && value.size() <= limit
          && value.matches('[\\s\\S]*\\S[\\s\\S]*');
      }
      allow read: if (signedIn() && resource.data.submitterID == request.auth.uid) || admin();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && get(/databases/$(database)/documents/residents/$(request.auth.uid)).data.role == 'Resident'
        && request.resource.data.keys().hasAll([
          'submitterID', 'issueCategory', 'barangayArea', 'locationDescription',
          'issueDescription', 'timestamp', 'updatedAt', 'reportStatus'])
        && request.resource.data.keys().hasOnly([
          'submitterID', 'issueCategory', 'barangayArea', 'locationDescription',
          'issueDescription', 'timestamp', 'updatedAt', 'reportStatus', 'geoLocation', 'supportingImageURL'])
        && request.resource.data.submitterID == request.auth.uid
        && request.resource.data.reportStatus == 'Received'
        && request.resource.data.timestamp == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.issueCategory in [
          'Road and public infrastructure damage', 'Malfunctioning public streetlights',
          'Clogged or damaged drainage systems', 'Improper waste disposal',
          'Minor flooding caused by blocked waterways', 'Deterioration of municipal public facilities']
        && request.resource.data.barangayArea in [
          'Amatong', 'Anahao', 'Bangon', 'Batiano', 'Budiong', 'Canduyong', 'Dapawan',
          'Gabawan', 'Libertad', 'Ligaya', 'Liwanag', 'Liwayway', 'Malilico', 'Mayha',
          'Panique', 'Pato-o', 'Poctoy', 'Progreso Este', 'Progreso Weste', 'Rizal',
          'Tabing Dagat', 'Tabobo-an', 'Tuburan', 'Tumingad', 'Tulay']
        && validText(request.resource.data.locationDescription, 500)
        && validText(request.resource.data.issueDescription, 5000)
        && (!('geoLocation' in request.resource.data) || request.resource.data.geoLocation is latlng)
        && (!('supportingImageURL' in request.resource.data)
          || request.resource.data.supportingImageURL == request.auth.uid + '/' + reportId + '/image');
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportStatus', 'priorityLevel', 'routingLevel', 'referredTo', 'updatedAt'])
        && request.resource.data.reportStatus in [
          'Received', 'For Verification', 'Referred', 'Ongoing', 'Resolved', 'Not Within LGU Jurisdiction']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('priorityLevel', null) in [null, 'High', 'Medium', 'Low']
        && request.resource.data.get('routingLevel', null) in [null, 'Barangay', 'Municipal', 'External']
        && (request.resource.data.get('referredTo', null) == null
          || validText(request.resource.data.referredTo, 200));
      allow delete: if false;
    }
    // Events are saved atomically with the report; read receipts belong to each viewer.
    function canReadNotification(data) {
      return signedIn() && ((data.kind == 'new-report' && admin())
        || (data.kind == 'report-update' && data.recipient == request.auth.uid));
    }
    match /notifications/{eventId} {
      allow read: if canReadNotification(resource.data);
      allow create: if signedIn() && validNotification();
      function validNotification() {
        let data = request.resource.data;
        let path = /databases/$(database)/documents/reports/$(data.reportId);
        let after = getAfter(path).data;
        return data.keys().hasAll(['kind', 'reportId', 'recipient', 'category', 'barangay', 'createdAt'])
          && data.reportId is string && data.reportId.matches('[A-Za-z0-9_-]{1,128}')
          && data.createdAt == request.time
          && data.category == after.issueCategory && data.barangay == after.barangayArea
          && ((data.kind == 'new-report'
            && data.keys().hasOnly(['kind', 'reportId', 'recipient', 'category', 'barangay', 'createdAt'])
            && eventId == data.reportId && data.recipient == 'admins'
            && !exists(path) && after.timestamp == request.time
            && after.submitterID == request.auth.uid)
          || (data.kind == 'report-update' && admin()
            && data.keys().hasOnly(['kind', 'reportId', 'recipient', 'category', 'barangay', 'createdAt', 'reportStatus', 'referredTo'])
            && data.recipient == after.submitterID && after.updatedAt == request.time
            && data.reportStatus == after.reportStatus
            && data.referredTo == after.get('referredTo', null)
            && (get(path).data.reportStatus != after.reportStatus
              || get(path).data.get('referredTo', null) != after.get('referredTo', null))));
      }
    }
    match /notificationUsers/{uid}/reads/{eventId} {
      allow read: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time
        && canReadNotification(get(/databases/$(database)/documents/notifications/$(eventId)).data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
